{
  "name": "@gobrand/openstory-vite",
  "version": "0.6.2",
  "private": false,
  "description": "Vite plugin that serves the OpenStory preview harness for a project",
  "keywords": [
    "component-preview",
    "openstory",
    "preview",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/go-brand/openstory#readme",
  "bugs": {
    "url": "https://github.com/go-brand/openstory/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-brand/openstory.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project-identity": {
      "types": "./dist/project-identity.d.ts",
      "import": "./dist/project-identity.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gobrand/openstory-config": "workspace:^",
    "@gobrand/openstory-runtime": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
