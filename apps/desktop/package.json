{
  "name": "openstory-desktop",
  "private": true,
  "version": "0.4.0",
  "description": "OpenStory — a Storybook alternative you point at any repo.",
  "author": "go-brand <hello@gobrand.app>",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package": "electron-vite build && electron-builder",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "11.0.0",
    "tailwind-merge": "^3.6.0",
    "vite": "8.1.0"
  },
  "devDependencies": {
    "@gobrand/openstory-config": "workspace:*",
    "@gobrand/openstory-vite": "workspace:*",
    "@playwright/test": "1.49.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "app.gobrand.openstory",
    "productName": "OpenStory",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "scripts/AppIcon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
